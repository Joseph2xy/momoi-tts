# Copy to .local/generation.env. Never share the private file.
# Choose codex or openrouter. No OpenRouter model is selected by this template.
TYRONE_TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-private-key
OPENROUTER_MODEL=organization/model:free
# Development token ceiling, distinct from the existing 60-word spoken limit.
OPENROUTER_MAX_TOKENS=1024
# This integration currently restricts OpenRouter routes to zero price.
# Live trials require separately checking model/account access and free allowance.
