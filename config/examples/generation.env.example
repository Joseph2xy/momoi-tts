# Copy to .local/generation.env. Never share the private file.
# Explicitly select OpenRouter and replace the example with your chosen exact model ID.
MOMOI_TTS_TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-private-key
OPENROUTER_MODEL=organization/model:free
# Response token ceiling, distinct from the 60-word spoken limit.
OPENROUTER_MAX_TOKENS=1024
# Models may be paid or free. Check model/account access, price and allowance before testing.
