# Development/recovery template. Receiving streamers use Settings -> Twitch.
# Use the maintainer's stable Public app client ID, not a separate streamer registration.
TWITCH_CLIENT_ID=replace_with_momoitts_public_client_id
TWITCH_CHANNEL=replace_with_broadcaster_login
TWITCH_REWARD_TITLE=Ask a character
TWITCH_REWARD_COST=1000
TWITCH_REWARD_COOLDOWN=60
# Guided setup saves TWITCH_REWARD_ID after explicit reward creation.
