FISH_API_KEY=replace_with_private_key
# S2.1 Pro Free is the default. Optional explicit engine selection:
# FISH_MODEL=s2.1-pro-free
# Tyrone's assigned voice; other voice variables are listed in characters/catalog.json.
FISH_VOICE_ID=replace_with_private_voice_id
# Provisional queue durations, in milliseconds.
MOMOI_TTS_VIEWER_COOLDOWN_MS=10000
MOMOI_TTS_GLOBAL_COOLDOWN_MS=1000
MOMOI_TTS_WAITING_EXPIRY_MS=180000
