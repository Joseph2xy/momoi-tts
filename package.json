{
  "name": "momoitts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build/package.ps1",
    "build:browser": "vite build",
    "build": "npm run typecheck && npm run build:browser",
    "dev:browser": "vite build --watch",
    "dev:server": "node --watch src/app/main.ts",
    "start": "node scripts/launch/run.ts",
    "pretest": "npm run build:browser",
    "test": "node --test tests/*.test.ts",
    "test:offline": "npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "format": "prettier --write src web tests \"scripts/**/*.ts\" vite.config.ts",
    "format:check": "prettier --check src web tests \"scripts/**/*.ts\" vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@tanstack/query-core": "^5.104.1",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "prettier": {
    "endOfLine": "auto",
    "singleQuote": true,
    "printWidth": 100
  },
  "license": "MIT"
}
